# Copy this file to .env.local and fill in the values after each =
# (no spaces, no quotes). Never commit .env.local.

# Gemini (AI that reads review text)
GEMINI_API_KEY=

# Supabase (Project Settings -> API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. No NEXT_PUBLIC_ prefix, so it never reaches the browser.
SUPABASE_SECRET_KEY=
